# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# TikTok Content Posting API app (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://renatosv98.github.io/GTAvideos/tiktok-callback.html

# Instagram API with Instagram Login (developers.facebook.com -> app -> Instagram product)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://renatosv98.github.io/GTAvideos/oauth-callback.html

# YouTube: put the OAuth "Desktop app" client JSON at secrets/youtube_client_secret.json
